{
  "name": "fluid-loading",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "rgdlr <rodrigrtic@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgdlr/fluid-loading.git"
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "changeset": "changeset",
    "dev": "pnpm --filter @fluid-loading/landing dev",
    "prepublish:check": "pnpm run typecheck && pnpm test && pnpm -r run build",
    "preview": "pnpm --filter @fluid-loading/landing preview",
    "publish-packages": "changeset publish",
    "test:watch": "vitest",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:pub": "publint packages/core && publint packages/react",
    "format": "biome format --write .",
    "version-packages": "changeset version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.5.1",
    "publint": "^0.3.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.6"
  }
}
