{
  "name": "fluid-loading",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "rgdlr <rodrigrtic@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgdlr/fluid-loading.git"
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "changeset": "changeset",
    "dev": "pnpm --filter @fluid-loading/landing dev",
    "prepublish:check": "pnpm run typecheck && pnpm test && pnpm -r run build",
    "preview": "pnpm --filter @fluid-loading/landing preview",
    "publish-packages": "pnpm -r publish --access public",
    "test:watch": "vitest",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.6"
  }
}
