{
  "name": "@fluid-loading/react",
  "version": "0.1.0",
  "description": "React adapter for Fluid Loading transition engine",
  "license": "MIT",
  "author": "rgdlr <rodrigrtic@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgdlr/fluid-loading.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/rgdlr/fluid-loading/issues"
  },
  "homepage": "https://github.com/rgdlr/fluid-loading#readme",
  "keywords": [
    "react",
    "loading",
    "skeleton",
    "layout",
    "transition",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fluid-loading/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}


