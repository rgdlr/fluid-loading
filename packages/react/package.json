{
  "name": "@fluid-loading/react",
  "version": "0.1.0",
  "description": "React adapter for Fluid Loading transition engine",
  "license": "MIT",
  "keywords": [
    "react",
    "loading",
    "skeleton",
    "layout",
    "transition",
    "ui"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc && node -e \"fs.copyFileSync('../core/src/styles.css', 'dist/styles.css')\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fluid-loading/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
