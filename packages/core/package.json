{
  "name": "@fluid-loading/core",
  "version": "0.1.0",
  "description": "Core layout measurement and skeleton transition engine for Fluid Loading",
  "license": "MIT",
  "keywords": [
    "loading",
    "skeleton",
    "layout",
    "transition",
    "animation",
    "ui"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc && node -e \"fs.copyFileSync('styles.css', 'dist/styles.css')\"",
    "typecheck": "tsc --noEmit"
  }
}
